# ==============================================================
# RCH Image to Excel - AI Configuration
# ==============================================================

# OPTION 1: Google Gemini (100% FREE Tier - Recommended!)
# Get your free key at: https://aistudio.google.com/app/apikey (No credit card required)
# 15 requests/min and 1,500 requests/day completely FREE
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OPTION 2: OpenAI API (Pay-as-you-go, ~$0.0003 per image with gpt-4o-mini)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OPTION 3 (Optional): Custom OpenAI-Compatible Base URL (e.g. OpenRouter, Local Ollama, Groq)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Max uploaded image size limit in MB
MAX_IMAGE_MB=20
